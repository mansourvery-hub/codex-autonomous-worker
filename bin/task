#!/usr/bin/env python3
import sys
import os
import time
import json
import yaml
import glob
import argparse
import subprocess
from pathlib import Path

TASKS_DIR = Path("/home/ubuntu/srv-codex/tasks")
LOGS_DIR = Path("/home/ubuntu/srv-codex/logs")
STATE_DIR = Path("/home/ubuntu/srv-codex/state")
REPOS_DIR = Path("/home/ubuntu/srv-codex/repos")

def get_next_task_id():
    existing = glob.glob(str(TASKS_DIR / "*.yaml")) + glob.glob(str(TASKS_DIR / "*.yml")) + glob.glob(str(TASKS_DIR / "*.json"))
    nums = []
    for f in existing:
        base = Path(f).name.split(".")[0].split("-")[0]
        if base.isdigit():
            nums.append(int(base))
    return f"{(max(nums) + 1 if nums else 1):03d}"

def cmd_add(args):
    prompt_text = " ".join(args.prompt).strip()
    if not prompt_text:
        print("Error: Prompt cannot be empty. Usage: task <prompt> [-r repo] [-m model]")
        sys.exit(1)
    repo = args.repo
    if not repo:
        try:
            cwd_repo = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], stderr=subprocess.DEVNULL, text=True).strip()
            repo = Path(cwd_repo).name
        except Exception:
            repo = "chess-repertoire-srs"
    task_id = get_next_task_id()
    filename = f"{task_id}-{args.type}.yaml"
    task_file = TASKS_DIR / filename
    data = {
        "id": task_id,
        "repo": repo,
        "type": args.type,
        "mode": getattr(args, "mode", "continuous"),
        "iterations": getattr(args, "iterations", 15),
        "priority": args.priority,
        "status": "pending",
        "model": args.model if args.model else "agentrouter/deepseek-v4-flash",
        "prompt": prompt_text
    }
    with open(task_file, "w") as f:
        yaml.dump(data, f, default_flow_style=False)
    print(f"[32m✔ Task #{task_id} queued for {repo} (mode={data['mode']}):[0m")
    print(f"  Prompt: {prompt_text}")
    print(f"  Model: {data['model']}")
    print("Run task tui to enter the live split control surface.")
def cmd_attach(args):
    res = subprocess.run(["tmux", "has-session", "-t", "codex-live"], capture_output=True)
    if res.returncode == 0:
        print("[32mAttaching directly to live Codex session (press Ctrl-b d to detach without stopping)...[0m")
        time.sleep(0.5)
        subprocess.run(["tmux", "attach", "-t", "codex-live"])
    else:
        print("No Codex session is currently running. Queue a task with: task 'your task'")

def cmd_tui(args=None):
    sidebar_script = Path(__file__).resolve().parent / "sidebar.py"
    if not sidebar_script.exists():
        sidebar_script = Path("/home/ubuntu/codex-worker/sidebar.py")
        if not sidebar_script.exists():
            sidebar_script = Path("/home/ubuntu/github-projects/codex-autonomous-worker/bin/sidebar.py")

    res = subprocess.run(["tmux", "has-session", "-t", "codex-tui"], capture_output=True)
    if res.returncode != 0:
        subprocess.run(["tmux", "new-session", "-d", "-s", "codex-tui", "-n", "main"], capture_output=True)
        subprocess.run(["tmux", "split-window", "-h", "-t", "codex-tui:0", "-p", "72"], capture_output=True)
        subprocess.run(["tmux", "set-option", "-t", "codex-tui", "status-style", "bg=#181825,fg=#cdd6f4"], capture_output=True)
        subprocess.run(["tmux", "set-option", "-t", "codex-tui", "pane-border-style", "fg=#313244"], capture_output=True)
        subprocess.run(["tmux", "set-option", "-t", "codex-tui", "pane-active-border-style", "fg=#89b4fa"], capture_output=True)
        
        # Configure pane navigation hotkeys
        subprocess.run(["tmux", "bind-key", "-t", "codex-tui", "-n", "F6", "select-pane", "-t", ":.+"], capture_output=True)
        subprocess.run(["tmux", "bind-key", "-t", "codex-tui", "-n", "M-Left", "select-pane", "-t", "0"], capture_output=True)
        subprocess.run(["tmux", "bind-key", "-t", "codex-tui", "-n", "M-Right", "select-pane", "-t", "1"], capture_output=True)
        subprocess.run(["tmux", "bind-key", "-t", "codex-tui", "-n", "C-w", "select-pane", "-t", ":.+"], capture_output=True)

        subprocess.run(["tmux", "send-keys", "-t", "codex-tui:0.0", f"python3 {sidebar_script}", "C-m"], capture_output=True)

        live_check = subprocess.run(["tmux", "has-session", "-t", "codex-live"], capture_output=True)
        if live_check.returncode == 0:
            subprocess.run(["tmux", "send-keys", "-t", "codex-tui:0.1", "TMUX= tmux attach -t codex-live", "C-m"], capture_output=True)
        else:
            welcome_cmd = "echo '=== Codex Control Surface (t3code TUI) ==='; echo 'Left pane: select tasks and view status.'; echo 'Press [Enter] on a running task to view and talk with Codex here.'; echo 'Press [F6] or [Alt-Left] to switch back to the sidebar.'; echo ''; echo 'Queue a new task with [n] or run: task <prompt>'"
            subprocess.run(["tmux", "send-keys", "-t", "codex-tui:0.1", welcome_cmd, "C-m"], capture_output=True)

    subprocess.run(["tmux", "attach", "-t", "codex-tui"])

def cmd_list(args):
    print("[1m=== Active / Pending Tasks ===[0m")
    files = sorted(TASKS_DIR.glob("*"))
    if not files:
        print("  (Queue is empty)")
    for f in files:
        status = "pending"
        for s in ["claimed", "done", "failed"]:
            if f".{s}." in f.name or f.name.endswith(f".{s}.yaml"):
                status = s
        color = "[33m" if status == "claimed" else ("[32m" if status == "done" else ("[31m" if status == "failed" else "[36m"))
        print(f"  {color}[{status.upper()}][0m {f.name}")

def cmd_current(args):
    current_file = STATE_DIR / "current.json"
    if current_file.exists():
        try:
            data = json.loads(current_file.read_text())
            print("[1;32mCurrently Running Task:[0m")
            for k, v in data.items():
                print(f"  {k}: {v}")
            print("Run task tui to enter the live split control surface.")
            print("Run task tui to enter the live split control surface.")
            return
        except Exception:
            pass
    print("No task currently executing.")

def cmd_history(args):
    hist_file = STATE_DIR / "history.jsonl"
    if not hist_file.exists():
        print("No history recorded yet.")
        return
    print("[1m=== Recent Task History ===[0m")
    with open(hist_file, "r") as f:
        lines = f.readlines()
        for l in lines[-args.n:]:
            item = json.loads(l)
            status_color = "[32m" if item.get("status") == "completed" else "[31m"
            print(f"  Task {item.get('task')} [{item.get('repo')}] -> {status_color}{item.get('status')}[0m ({item.get('model')})")
            if item.get("notes"):
                print(f"    Notes: {', '.join(item['notes'])}")

def cmd_logs(args):
    if args.last:
        logs = sorted(LOGS_DIR.glob("codex_*.log"), key=os.path.getmtime)
        if not logs:
            print("No execution logs found.")
            return
        target = logs[-1]
        print(f"[1mShowing latest task log ({target.name}):[0m")
        if args.follow:
            subprocess.run(["tail", "-f", str(target)])
        else:
            subprocess.run(["tail", f"-n{args.lines}", str(target)])
    else:
        worker_log = LOGS_DIR / "worker.log"
        if not worker_log.exists():
            print("Worker log not found.")
            return
        if args.follow:
            subprocess.run(["tail", "-f", str(worker_log)])
        else:
            subprocess.run(["tail", f"-n{args.lines}", str(worker_log)])

def main():
    if len(sys.argv) == 1:
        cmd_tui()
        return

    KNOWN_COMMANDS = {"tui", "add", "attach", "list", "current", "history", "logs", "-h", "--help"}
    if len(sys.argv) > 1 and sys.argv[1] not in KNOWN_COMMANDS:
        sys.argv.insert(1, "add")

    parser = argparse.ArgumentParser(description="Codex Autonomous Worker CLI", prog="task")
    sub = parser.add_subparsers(dest="command")

    p_tui = sub.add_parser("tui", help="Launch the split-screen TUI control surface")

    p_add = sub.add_parser("add", help="Queue a new task prompt")
    p_add.add_argument("prompt", nargs="+", help="Task instructions for the worker")
    p_add.add_argument("-r", "--repo", default=None, help="Target repository name")
    p_add.add_argument("-m", "--model", default=None, help="Model override")
    p_add.add_argument("-t", "--type", default="feature", help="Task type (bugfix, feature, chore, test)")
    p_add.add_argument("--mode", default="continuous", choices=["single", "continuous"], help="Execution mode")
    p_add.add_argument("--iterations", type=int, default=15, help="Max iterations for continuous mode")
    p_add.add_argument("-p", "--priority", default="medium", choices=["low", "medium", "high"])

    sub.add_parser("attach", help="Attach directly into the live interactive Codex TUI session")
    sub.add_parser("list", help="List all tasks in queue")
    sub.add_parser("current", help="Show currently running task details")

    p_hist = sub.add_parser("history", help="Show finished tasks history")
    p_hist.add_argument("-n", type=int, default=10, help="Number of records to show")

    p_logs = sub.add_parser("logs", help="View supervisor or execution logs")
    p_logs.add_argument("-f", "--follow", action="store_true", help="Follow log stream")
    p_logs.add_argument("-n", "--lines", type=int, default=30, help="Number of lines")
    p_logs.add_argument("--last", action="store_true", help="View the most recent task execution log")

    args = parser.parse_args()

    if args.command == "tui":
        cmd_tui(args)
    elif args.command == "add":
        cmd_add(args)
    elif args.command == "attach":
        cmd_attach(args)
    elif args.command == "list":
        cmd_list(args)
    elif args.command == "current":
        cmd_current(args)
    elif args.command == "history":
        cmd_history(args)
    elif args.command == "logs":
        cmd_logs(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
