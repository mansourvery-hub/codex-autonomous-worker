#!/usr/bin/env python3
import sys
import subprocess
from pathlib import Path

autopilot_bin = Path(__file__).resolve().parent / "autopilot"
if not autopilot_bin.exists():
    autopilot_bin = Path("/home/ubuntu/.local/bin/autopilot")

cmd = [sys.executable, str(autopilot_bin)] + sys.argv[1:]
sys.exit(subprocess.call(cmd))
